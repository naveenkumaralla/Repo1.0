from extras.scripts import Script

from netbox_aws_sync.models import AWSCredential
from netbox_aws_sync.sync import sync_credential


class SyncAllAWSResources(Script):

    class Meta:
        name = "Sync all AWS resources"
        description = "Synchronize all enabled AWS credentials."
        scheduling_enabled = True
        job_timeout = 3600

    def run(self, data, commit):
        credentials = AWSCredential.objects.filter(enabled=True)

        if not credentials.exists():
            self.log_warning("No enabled AWS credentials were found.")
            return "No enabled credentials"

        successful = 0
        failed = 0

        for credential in credentials:
            self.log_info(f"Starting sync for {credential.name}")

            try:
                sync_credential(credential.pk)
                successful += 1
                self.log_success(
                    f"Completed sync for {credential.name}"
                )
            except Exception as exc:
                failed += 1
                self.log_failure(
                    f"Sync failed for {credential.name}: {exc}"
                )

        return (
            f"AWS synchronization completed: "
            f"{successful} successful, {failed} failed"
        )
